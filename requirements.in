# Runtime dependencies (scaffold set). Pin with:
#   uv pip compile --universal requirements.in -o requirements.txt
# Work packages add their own libraries here (PyMuPDF, trafilatura, FlagEmbedding, torch, langgraph, ...)
# and re-run the compile step, so requirements.txt always stays fully pinned.

fastapi
uvicorn[standard]
pydantic[email]
pydantic-settings
python-multipart
httpx
structlog
tenacity
qdrant-client
sqlalchemy[asyncio]
aiosqlite
pyjwt
pwdlib[argon2]
slowapi

# Extraction and OCR (MVP slice 1)
pymupdf
pytesseract
pillow
trafilatura
selectolax
python-docx
python-pptx
filetype
defusedxml
charset-normalizer
# Tokenizer for token-based chunk sizes (BGE-M3 / XLM-R tokenizer files only, no model weights)
tokenizers
huggingface_hub

# Generation, guardrails, orchestration (MVP slices 3 and 6)
langchain-openai
langchain-core
langgraph
rapidfuzz
pyyaml

# Heavy ML (torch, FlagEmbedding) lives in requirements-ml.in, and RAGAS in requirements-eval.in,
# so CI and the CPU image stay light. Both are compiled with  -c requirements.txt.
