# Copy to frontend/.env.local and adjust. Never commit .env.local.

# --- Server-side only (read by the /api route handlers; never shipped to the browser) ---
# FastAPI origin the BFF proxy forwards /api/* to.
API_BASE_URL=http://127.0.0.1:8000
# Upstream timeout for proxied calls, in ms (an /ask can take several seconds).
API_TIMEOUT_MS=120000
# Force the session cookie's Secure flag: 1 = always, 0 = never. Default: Secure in production only.
# COOKIE_SECURE=1

# --- Public build-time switches (inlined into the browser bundle) ---
# 1 = serve every API call from src/lib/mocks.ts; no backend needed.
NEXT_PUBLIC_USE_MOCKS=0
# Mock mode only: "admin" shows edit/delete on official rows and the "Add to official sources" option.
NEXT_PUBLIC_MOCK_ROLE=user
# Must match the backend's PRIVATE_CONTEXT_POLICY so the upload privacy notice says the right thing.
NEXT_PUBLIC_PRIVATE_CONTEXT_POLICY=hosted_with_notice
