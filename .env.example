# Copy to .env and fill in. Every variable is documented in app/config.py and blueprint §12.1.
# .env is gitignored; never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false
CORS_ORIGINS=http://localhost:3000
DEVICE=auto                                   # auto → cuda if available, else cpu

# --- LLM endpoints (OpenAI-compatible) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=                               # REQUIRED: your key from build.nvidia.com (starts with nvapi-). Never commit it.
LOCAL_FALLBACK_ENABLED=false                  # true: Ollama answers (degraded) when every hosted model failed; required by PRIVATE_CONTEXT_POLICY=local_only
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1     # only used when LOCAL_FALLBACK_ENABLED=true
OLLAMA_REQUIRED=false
GENERATION_MODELS=deepseek-ai/deepseek-v3.1,qwen/qwen3-235b-a22b,meta/llama-3.3-70b-instruct   # verify: python scripts/check_models.py
HELPER_MODEL=meta/llama-3.3-70b-instruct
JUDGE_MODEL=openai/gpt-oss-120b
LOCAL_FALLBACK_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_S=45
LLM_HELPER_TIMEOUT_S=20
LLM_MAX_RPM=35                                # NVIDIA free tier is ~40 requests/minute
LLM_JSON_MODE=true
PRIVATE_CONTEXT_POLICY=hosted_with_notice     # hosted_with_notice | local_only (needs LOCAL_FALLBACK_ENABLED=true)

# --- Hosted retrieval models (default; same NVIDIA_API_KEY) ---
EMBEDDING_PROVIDER=nvidia                     # nvidia | local
HOSTED_EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=nvidia                      # nvidia | local
HOSTED_RERANKER_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
HOSTED_RERANKER_URL=                          # empty: derived from NVIDIA_RETRIEVAL_BASE_URL and the model
NVIDIA_RETRIEVAL_BASE_URL=https://ai.api.nvidia.com/v1/retrieval
INJECTION_PROVIDER=nvidia                     # nvidia | none
JAILBREAK_DETECT_URL=https://ai.api.nvidia.com/v1/security/nvidia/nemoguard-jailbreak-detect
HOSTED_RETRIEVAL_TIMEOUT_S=20

# --- Optional local models (EMBEDDING_PROVIDER / RERANKER_PROVIDER = local; EMBEDDING_MODEL is also the chunk tokenizer) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INJECTION_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
EMBED_BATCH_SIZE=32
GPU_FP16=true

# --- Stores ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=                               # Qdrant Cloud only
QDRANT_COLLECTION_ALIAS=chunks_active
DATABASE_URL=sqlite+aiosqlite:///./data/app.sqlite3
STORAGE_DIR=./storage

# --- Limits ---
MAX_UPLOAD_MB=50
SYNC_INGEST_MAX_MB=10
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_LOGIN=5/minute

# --- Multi-tenancy (§5.8) ---
PUBLIC_OWNER_ID=u_public
MAX_DOCS_PER_USER=50
MAX_STORAGE_MB_PER_USER=200
MAX_CHUNKS_PER_USER=20000
MAX_INGEST_JOBS_PER_USER=2
RESPONSE_CACHE=eval_only

# --- Citizen-services domain ---
STALE_AFTER_MONTHS=12
ADVICE_GUARD=true
EMERGENCY_GUARD=true
JURISDICTIONS=federal,punjab,sindh,kp
OCR_ENABLED=true
OCR_LANGS=eng+urd

# --- Auth / observability ---
JWT_SECRET=                                   # REQUIRED: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_TTL_MIN=30
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_MASK_PRIVATE_TEXT=true
