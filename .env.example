# Copy to .env and fill in. Every variable is documented in app/config.py and blueprint §12.1.
# .env is gitignored; never commit real secrets.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false
CORS_ORIGINS=http://localhost:3000
DEVICE=auto                                   # auto → cuda if available, else cpu

# --- LLM endpoint (OpenAI-compatible; the OpenAI API by default) ---
LLM_BASE_URL=https://api.openai.com/v1         # any OpenAI-compatible base works
LLM_API_KEY=                                  # REQUIRED unless OPENAI_API_KEY is set (it is the LLM key while LLM_BASE_URL is OpenAI). Never commit it.
OPENAI_API_KEY=sk-...                         # chat key fallback and the embeddings key; one key can serve both
LOCAL_FALLBACK_ENABLED=false                  # true: Ollama answers (degraded) when every hosted model failed; required by PRIVATE_CONTEXT_POLICY=local_only
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1     # only used when LOCAL_FALLBACK_ENABLED=true
OLLAMA_REQUIRED=false
GENERATION_MODELS=gpt-4.1-mini,gpt-4o-mini    # verify: python scripts/check_models.py
HELPER_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4o                            # a different model from the generator, to reduce self-preference bias
LOCAL_FALLBACK_MODEL=qwen2.5:3b-instruct
# Cost per question (dashboard). Hosted calls count as billed; LLM_BILLED=false zeroes the actual cost
# (the list price stays). For a "what it would cost" figure fill MODEL_PRICES from https://openai.com/api/pricing,
# as JSON of model id -> [USD per 1M input tokens, USD per 1M output tokens]. Left empty, list price shows $0.
# LLM_BILLED=true
# Example values (check the pricing page):
# MODEL_PRICES={"gpt-4.1-mini": [0.4, 1.6], "gpt-4o-mini": [0.15, 0.6], "gpt-4o": [2.5, 10.0]}
MODEL_PRICES={}
LLM_TIMEOUT_S=45
LLM_HELPER_TIMEOUT_S=20
LLM_MAX_RPM=300                               # client-side pacing; keep under your OpenAI tier's requests-per-minute limit
LLM_TOKEN_PARAM=max_tokens                    # max_tokens | max_completion_tokens (OpenAI gpt-5* / o* reasoning models; also drops temperature)
LLM_JSON_MODE=true
PRIVATE_CONTEXT_POLICY=hosted_with_notice     # hosted_with_notice | local_only (needs LOCAL_FALLBACK_ENABLED=true)

# --- Retrieval models ---
EMBEDDING_PROVIDER=openai                     # openai | local (BGE-M3 on this machine)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1024                      # sent as `dimensions`; must match the Qdrant collection
RERANKER_PROVIDER=local                       # local (BGE reranker on the GPU) | none (gate on dense similarity)
HOSTED_RETRIEVAL_TIMEOUT_S=20
# Changing the embedding provider changes the vectors: use a fresh Qdrant collection and re-seed.
# For gpt-5* / o* models also set LLM_TOKEN_PARAM=max_completion_tokens.

# --- Local models (the reranker; the embedder when EMBEDDING_PROVIDER=local; EMBEDDING_MODEL is also the chunk tokenizer) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INJECTION_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
EMBED_BATCH_SIZE=32
GPU_FP16=true

# --- Stores ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=                               # Qdrant Cloud only
QDRANT_COLLECTION_ALIAS=chunks_active
DATABASE_URL=sqlite+aiosqlite:///./data/app.sqlite3
STORAGE_DIR=./storage

# --- Limits ---
MAX_UPLOAD_MB=50
SYNC_INGEST_MAX_MB=10
# PDFs with more pages than this are ingested in the background (202)
SYNC_INGEST_MAX_PAGES=80
# Background ingestion jobs that run at once
BACKGROUND_INGEST_WORKERS=2
# Background jobs accepted (running + waiting) before uploads get 429
BACKGROUND_INGEST_QUEUE_MAX=20
RATE_LIMIT_ASK=30/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_LOGIN=5/minute

# --- Multi-tenancy (§5.8) ---
PUBLIC_OWNER_ID=u_public
MAX_DOCS_PER_USER=50
MAX_STORAGE_MB_PER_USER=200
MAX_CHUNKS_PER_USER=20000
MAX_INGEST_JOBS_PER_USER=2
RESPONSE_CACHE=eval_only
# Honour the X-Eval-Config header on /ask and /search for ADMIN callers (eval harness configs: dense-only,
# no-rerank, another generation model). Leave false in production.
EVAL_OVERRIDES_ENABLED=false

# --- Citizen-services domain ---
STALE_AFTER_MONTHS=12
ADVICE_GUARD=true
EMERGENCY_GUARD=true
JURISDICTIONS=federal,punjab,sindh,kp
OCR_ENABLED=true
OCR_LANGS=eng+urd

# --- Auth / observability ---
JWT_SECRET=                                   # REQUIRED: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_TTL_MIN=30
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_MASK_PRIVATE_TEXT=true

# --- Production (docs/DEPLOY.md) ---
# APP_ENV=prod makes the API refuse to start unless: JWT_SECRET is not the default and is >= 32 chars,
# the LLM key is set (plus an OpenAI key for EMBEDDING_PROVIDER=openai; it may be the same key),
# CORS_ORIGINS is non-empty without '*', and LOG_QUESTION_TEXT=false.
# APP_ENV=prod
# JWT_SECRET=                                 # python -c "import secrets; print(secrets.token_urlsafe(48))"
# CORS_ORIGINS=https://rag.example.org        # the public origin(s) of the web app; never *
# COOKIE_SECURE=1                             # web: Secure session cookie (needs HTTPS in front)
# FORWARDED_ALLOW_IPS=127.0.0.1               # proxy address(es) trusted for X-Forwarded-*; a Docker network CIDR if the proxy is a container
# QDRANT_API_KEY=                             # Qdrant Cloud only (and set QDRANT_URL to the cluster URL)
